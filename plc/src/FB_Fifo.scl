// M8 FIFO core. No transport fields, DB addresses, or physical I/O are used here.
FUNCTION_BLOCK "FB_Fifo"
VAR_INPUT
    Enqueue : Bool;
    EnqueueItem : "PLC_Command";
    Dequeue : Bool;              // one-cycle pulse supplied by FB_ButtonPulse
    Reset : Bool;
END_VAR
VAR_OUTPUT
    DequeuedItem : "PLC_Command";
    DequeueValid : Bool;
    QueueEmpty : Bool;
    QueueFull : Bool;
    QueueLength : USInt;
END_VAR
VAR_IN_OUT
    Buffer : "PLC_FifoBuffer";
END_VAR
VAR_TEMP
    DoEnqueue : Bool;
    DoDequeue : Bool;
    Index : Int;
END_VAR
BEGIN
    // Reset has priority and clears all observable state in one scan.
    DequeueValid := FALSE;
    DequeuedItem.Valid := FALSE;
    IF #Reset THEN
        #Buffer.Head := 0;
        #Buffer.Tail := 0;
        #Buffer.Count := 0;
        FOR #Index := 0 TO 2 DO
            #Buffer.Items[#Index].Valid := FALSE;
            #Buffer.Items[#Index].ShapeCode := 0;
            #Buffer.Items[#Index].SemanticId := 0;
        END_FOR;
        #Buffer.Head := 0;
        #Buffer.Tail := 0;
    ELSE
        // A valid dequeue frees one slot for a simultaneous enqueue.
        #DoDequeue := #Dequeue AND (#Buffer.Count > 0);
        #DoEnqueue := #Enqueue AND #EnqueueItem.Valid AND
                      ((#Buffer.Count < 3) OR #DoDequeue);

        IF #DoDequeue THEN
            #DequeuedItem := #Buffer.Items[#Buffer.Head];
            #DequeuedItem.Valid := TRUE;
            #DequeueValid := TRUE;
            #Buffer.Items[#Buffer.Head].Valid := FALSE;
            #Buffer.Head := (#Buffer.Head + 1) MOD 3;
            #Buffer.Count := #Buffer.Count - 1;
        END_IF;

        IF #DoEnqueue THEN
            #Buffer.Items[#Buffer.Tail] := #EnqueueItem;
            #Buffer.Items[#Buffer.Tail].Valid := TRUE;
            #Buffer.Tail := (#Buffer.Tail + 1) MOD 3;
            #Buffer.Count := #Buffer.Count + 1;
        END_IF;
    END_IF;

    #QueueLength := #Buffer.Count;
    #QueueEmpty := (#Buffer.Count = 0);
    #QueueFull := (#Buffer.Count = 3);
END_FUNCTION_BLOCK
