// TEST-ONLY wrapper around the real M8 application core.
// Test inputs are ignored unless Acceptance.TestEnable is TRUE.
//
// COMM-002 PC half lives in pc/communication/heartbeat.py: the PC writes a
// counter into M8_AcceptanceData.ReservedInputByte2 (DBB2) once per second and
// sets the enable bit M8_AcceptanceData.ReservedControl5 (DBX0.5). This block
// implements the PLC half: if that counter stops changing for 2 s the three
// sorting lamps blink at 2 Hz and the alarm state is mirrored into
// M8_AcceptanceData.ReservedStatus7 (DBX8.7) so the PC can read it back.
//
// The alarm is only armed while TestEnable AND the heartbeat enable bit are
// TRUE, so the acceptance tool (which never sets them) keeps the old behaviour.
FUNCTION_BLOCK "FB_M8_AcceptanceHarness"
VAR_INPUT
    CommandIn : "PLC_Command";
    CommandValid : Bool;
    PhysicalDequeueRaw : Bool;
    PhysicalResetRaw : Bool;
END_VAR
VAR_OUTPUT
    QueueEmpty : Bool;
    QueueFull : Bool;
    QueueLength : USInt;
    SortLed1 : Bool;
    SortLed2 : Bool;
    SortLed3 : Bool;
    QueueFullLed : Bool;
    CommLostAlarm : Bool;
END_VAR
VAR_IN_OUT
    Acceptance : "M8_AcceptanceData";
END_VAR
VAR
    Application : "FB_PlcApplication";
    HeartbeatWatchdog : TON_TIME;
    BlinkTimer : TON_TIME;
    BlinkPulseState : Bool;
    BlinkPhaseState : Bool;
    HeartbeatLast : USInt;
END_VAR
VAR_TEMP
    EffectiveCommand : "PLC_Command";
    EffectiveCommandValid : Bool;
    EffectiveDequeueRaw : Bool;
    EffectiveResetRaw : Bool;
    LastDequeuedValid : Bool;
    LastDequeuedShape : USInt;
    LastDequeuedSemanticId : DInt;
    HeartbeatChanged : Bool;
    HeartbeatArmed : Bool;
    CommLost : Bool;
END_VAR
BEGIN
    #EffectiveCommand := #CommandIn;
    #EffectiveCommandValid := #CommandValid;
    #EffectiveDequeueRaw := #PhysicalDequeueRaw;
    #EffectiveResetRaw := #PhysicalResetRaw;

    IF #Acceptance.TestEnable THEN
        #EffectiveCommand.Valid := #Acceptance.CommandDataValid;
        #EffectiveCommand.ShapeCode := #Acceptance.ShapeCode;
        #EffectiveCommand.SemanticId := #Acceptance.SemanticId;
        #EffectiveCommandValid := #Acceptance.CommandValidTest;
        #EffectiveDequeueRaw := #PhysicalDequeueRaw OR #Acceptance.DequeueTestRequest;
        #EffectiveResetRaw := #PhysicalResetRaw OR #Acceptance.ResetTestRequest;
    END_IF;

    #Application(CommandIn := #EffectiveCommand,
                 CommandValid := #EffectiveCommandValid,
                 DequeueButtonRaw := #EffectiveDequeueRaw,
                 ResetButtonRaw := #EffectiveResetRaw,
                 QueueEmpty => #QueueEmpty,
                 QueueFull => #QueueFull,
                 QueueLength => #QueueLength,
                 SortLed1 => #SortLed1,
                 SortLed2 => #SortLed2,
                 SortLed3 => #SortLed3,
                 QueueFullLed => #QueueFullLed,
                 LastDequeuedValid => #LastDequeuedValid,
                 LastDequeuedShape => #LastDequeuedShape,
                 LastDequeuedSemanticId => #LastDequeuedSemanticId);

    // ---------------------------------------------------------------- COMM-002
    // Free-running 2 Hz square wave for the alarm: a TON whose IN is its own
    // inverted Q pulses every 250 ms and toggles the phase.
    // The output goes through the Q parameter into a variable: reading the
    // instance member #BlinkTimer.Q directly in the same scan returns the stale
    // value on this CPU and the phase never toggled (measured 2026-09-11).
    #BlinkTimer(IN := NOT #BlinkPulseState, PT := T#250MS, Q => #BlinkPulseState);
    IF #BlinkPulseState THEN
        #BlinkPhaseState := NOT #BlinkPhaseState;
    END_IF;

    #HeartbeatArmed := #Acceptance.TestEnable AND #Acceptance.ReservedControl5;
    #HeartbeatChanged := (#Acceptance.ReservedInputByte2 <> #HeartbeatLast);
    IF #HeartbeatChanged THEN
        #HeartbeatLast := #Acceptance.ReservedInputByte2;
    END_IF;

    // IN stays TRUE while the counter is quiet; any change to the counter resets
    // the timer, so Q only becomes TRUE after 2 s without a new heartbeat.
    #HeartbeatWatchdog(IN := #HeartbeatArmed AND NOT #HeartbeatChanged,
                       PT := T#2S,
                       Q => #CommLost);

    // The alarm overrides the sorting display: all three lamps blink together.
    IF #CommLost THEN
        #SortLed1 := #BlinkPhaseState;
        #SortLed2 := #BlinkPhaseState;
        #SortLed3 := #BlinkPhaseState;
    END_IF;

    #Acceptance.AcceptanceReady := TRUE;
    #Acceptance.QueueEmpty := #QueueEmpty;
    #Acceptance.QueueFull := #QueueFull;
    #Acceptance.SortLed1 := #SortLed1;
    #Acceptance.SortLed2 := #SortLed2;
    #Acceptance.SortLed3 := #SortLed3;
    #Acceptance.LastDequeuedValid := #LastDequeuedValid;
    #Acceptance.QueueLength := #QueueLength;
    #Acceptance.LastDequeuedShape := #LastDequeuedShape;
    #Acceptance.LastDequeuedSemanticId := #LastDequeuedSemanticId;
    #Acceptance.CycleCounter := #Acceptance.CycleCounter + 1;
    #Acceptance.LayoutMagic := W#16#4D38;
    #Acceptance.LayoutVersion := 1;
    #Acceptance.ReservedStatus7 := #CommLost;   // CommLostAlarm, read back by the PC
    #CommLostAlarm := #CommLost;
END_FUNCTION_BLOCK
